# CyberShield backend environment template.
# Copy to `.env`/export as environment variables before first run; the app
# falls back to safe defaults when variables are unset.

# --- CORS ---
# Comma-separated browser origins allowed to call the API cross-origin.
# Defaults (unset) match the local Vite dev server. Set your real origin in
# production/docker, e.g. http://localhost when the frontend container
# serves the browser at http://localhost.
#CYBERSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite by default; use the same SQLAlchemy URL format for PostgreSQL.
#CYBERSHIELD_DATABASE_URL=sqlite:///cybershield.db

# --- External threat intelligence (Google Safe Browsing) ---
# Key is read only from the environment; never hardcoded, logged or stored.
GOOGLE_SAFE_BROWSING_API_KEY=
# Per-request timeout in seconds for provider lookups.
GOOGLE_SAFE_BROWSING_TIMEOUT_SECONDS=5.0

# --- External threat intelligence (VirusTotal v3) ---
# Second provider. Free tier: ~4 requests per minute, ~500 requests per day;
# no retries are issued, so keep scans user-paced. Key from env only.
VIRUS_TOTAL_API_KEY=
# Per-request timeout in seconds for provider lookups.
VIRUS_TOTAL_TIMEOUT_SECONDS=8.0

# Master switch for ALL external provider lookups (true/false).
# When false, providers are skipped entirely (no key needed).
CYBERSHIELD_THREAT_PROVIDER_ENABLED=true

# --- Threat-intelligence correlation tuning (initial values, not validated
# constants; tune after real multi-provider data exists). ---
# Points added to a flagged verdict's confidence per EXTRA agreeing provider.
THREAT_INTEL_AGREEMENT_BONUS=10
# Multiplier applied when providers materially conflict (malicious vs clean).
# Unavailable providers never count as a conflict.
THREAT_INTEL_CONFLICT_MULTIPLIER=0.85

# --- AI security explanation (optional, presentation layer ONLY) ---
# A best-effort, user-facing prose explanation of the deterministic result.
# It never influences the deterministic Trust Score, verdict, or findings,
# and the scan succeeds with or without it (any AI failure degrades to "no
# explanation"). Requires an OpenAI-compatible chat-completions endpoint.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_MODEL=gpt-4o-mini
#AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30.0
AI_MAX_TOKENS=800